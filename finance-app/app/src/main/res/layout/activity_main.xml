<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_main"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E1E1E"
        android:elevation="4dp">
        <TextView
            android:id="@+id/tv_dashboard_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Command Center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Admin: Global Liquidity -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_global_liquidity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="32dp"
                app:cardBackgroundColor="#1E1E1E"
                android:layout_marginBottom="32dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System Liquidity"
                        android:textColor="#03DAC5"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:textAllCaps="true" />
                    <TextView
                        android:id="@+id/tv_global_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Analyst Portfolio Overview -->
            <LinearLayout
                android:id="@+id/panel_analyst_portfolio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PORTFOLIO PERFORMANCE"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#1E1E1E">

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Managed Clients"
                                android:textColor="#03DAC5"
                                android:textSize="10sp"
                                android:textAllCaps="true"/>
                            <TextView
                                android:id="@+id/tv_portfolio_clients"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Asset Volume"
                                android:textColor="#BB86FC"
                                android:textSize="10sp"
                                android:textAllCaps="true"/>
                            <TextView
                                android:id="@+id/tv_portfolio_volume"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0.00"
                                android:textColor="#FFFFFF"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </GridLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/container_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="32dp"
                app:cardBackgroundColor="#BB86FC"
                android:layout_marginBottom="32dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Net Position"
                        android:textColor="#44000000"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-black"
                        android:textAllCaps="true" />
                    <TextView
                        android:id="@+id/tv_net_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#000000"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Admin Only: System Status -->
            <LinearLayout
                android:id="@+id/panel_manage_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="32dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM STATUS"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/card_nav_analysts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/bg_edittext"
                        android:layout_marginEnd="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ANALYSTS"
                            android:textColor="#BB86FC"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_total_analysts_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total: 0"
                            android:textColor="#88FFFFFF"
                            android:textSize="11sp"
                            android:layout_marginTop="12dp"/>
                        <ProgressBar
                            android:id="@+id/pb_analysts_total"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:progress="100"
                            android:progressTint="#33BB86FC"
                            android:layout_marginTop="4dp"/>
                        <TextView
                            android:id="@+id/tv_count_analysts_active"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active: 0"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:layout_marginTop="12dp"/>
                        <ProgressBar
                            android:id="@+id/pb_analysts_active"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:progress="0"
                            android:progressTint="#BB86FC"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/card_nav_clients"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/bg_edittext"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CLIENTS"
                            android:textColor="#03DAC5"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_total_clients_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total: 0"
                            android:textColor="#88FFFFFF"
                            android:textSize="11sp"
                            android:layout_marginTop="12dp"/>
                        <ProgressBar
                            android:id="@+id/pb_clients_total"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:progress="100"
                            android:progressTint="#3303DAC5"
                            android:layout_marginTop="4dp"/>
                        <TextView
                            android:id="@+id/tv_count_clients_active"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active: 0"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:layout_marginTop="12dp"/>
                        <ProgressBar
                            android:id="@+id/pb_clients_active"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:progress="0"
                            android:progressTint="#03DAC5"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Insight Section -->
            <LinearLayout
                android:id="@+id/container_insights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="40dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PORTFOLIO DISTRIBUTION"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />
                <LinearLayout
                    android:id="@+id/layout_category_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Recent Activity Section (Visible for Viewers) -->
            <LinearLayout
                android:id="@+id/container_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="40dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECENT ACTIVITY"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />
                <LinearLayout
                    android:id="@+id/layout_history_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#1E1E1E"
        app:itemIconTint="#BB86FC"
        app:itemTextColor="#FFFFFF"
        app:menu="@menu/nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>